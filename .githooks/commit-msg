#!/bin/sh
# Check the commit header is a Conventional Commit.
#
# The shape only: a header that parses says nothing about whether the body
# explains anything, and the body is the part that matters. This catches the
# mechanical mistake, not the substantive one.
set -e

header=$(head -1 "$1")

# A merge, revert, or fixup carries its own conventions.
case "$header" in
	Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|test|refactor|perf|chore|build|ci)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$header" | grep -Eq "$pattern"; then
	echo "commit-msg: the header is not a Conventional Commit."
	echo
	echo "  got:  $header"
	echo "  want: <type>(<scope>): <subject>"
	echo
	echo "  types: feat fix docs test refactor perf chore build ci"
	echo "  e.g.:  feat(issue): add issue get"
	echo "         fix(transport): name the failing endpoint in a 404"
	exit 1
fi

subject=${header#*: }
if [ ${#header} -gt 72 ]; then
	echo "commit-msg: the header is ${#header} characters; keep it under 72."
	echo "  $header"
	exit 1
fi
case "$subject" in
	*.) echo "commit-msg: the subject ends with a period; drop it."; exit 1 ;;
esac

# No markdown in the body.
#
# A commit message is plain text. Git renders nothing, and GitHub shows it
# preformatted, so a heading is the characters "## " and a table is a row of
# pipes on every surface that will ever display it. The history had both for a
# week, because the squash setting took the pull request description, which is
# markdown by design, as the commit body.
#
# What stays: hyphen bullets, indented blocks for code and log output,
# backticks around identifiers, bare URLs, and trailers. The test is whether it
# reads correctly unrendered, which is the only way it will ever be read.
#
# Headings are matched from two hashes rather than one. This file still holds
# git's own comment lines when a message is written in an editor, and those
# start with a single hash, so "# " cannot be told apart from an H1 here. Two
# is what the damage looked like anyway.
body=$(tail -n +2 "$1")

flag() {
	echo "commit-msg: $1 in the body, and a commit message is plain text."
	echo
	printf '%s\n' "$body" | grep -nE "$2" | head -3 | sed 's/^/  /'
	echo
	echo "  $3"
	echo
	echo "  Keep: hyphen bullets, indented code and log output, backticks,"
	echo "  bare URLs, trailers. It has to read correctly unrendered."
	exit 1
}

printf '%s\n' "$body" | grep -Eq '^#{2,6} ' &&
	flag "a markdown heading" '^#{2,6} ' "Say it in a sentence, or start a new paragraph."
printf '%s\n' "$body" | grep -Eq '^\|' &&
	flag "a markdown table" '^\|' "Use an indented block, or prose."
printf '%s\n' "$body" | grep -Eq '^[-*] \[[ xX]\]' &&
	flag "a task list" '^[-*] \[[ xX]\]' "Checklists belong on the pull request, not in the history."
printf '%s\n' "$body" | grep -Eq '^```' &&
	flag "a fenced code block" '^```' "Indent the block by four spaces instead."
printf '%s\n' "$body" | grep -Eq '\*\*[^*/ ][^*/]*\*\*' &&
	flag "markdown emphasis" '\*\*[^*/ ][^*/]*\*\*' "Emphasis does not survive plain text; write the sentence so it does not need it."
printf '%s\n' "$body" | grep -Eq '\[[^]]+\]\([^)]+\)' &&
	flag "a markdown link" '\[[^]]+\]\([^)]+\)' "Put the bare URL, which a terminal can follow."

# No tool attribution anywhere in the message.
#
# A commit message says what changed and why. Which editor, assistant, or
# harness produced it is not part of that, it is metadata about the authoring
# session, and it outlives the session by the whole life of the repository.
#
# This is here because a session trailer reached ten commits on main before
# anybody read one, and taking it back out cost a history rewrite: fifteen
# messages rewritten, a force-push past a ruleset that had to be lifted and
# put back, one published tag left pointing into the old history, and a hash
# in scripts/mutation-baseline.tsv that had to be restamped because it named
# a commit that no longer existed.
#
# A setting in somebody's home directory would not have stopped it. That
# setting existed and was set to false; it governed a different trailer. This
# runs from the repository, for every clone that installs the hooks, and does
# not care which tool is holding the pen.
#
# The whole message is searched rather than the trailer block alone: an
# attribution line is not always last, and a body that merely mentions one of
# these URLs is a body quoting something that does not belong in history
# either.
whole=$(cat "$1")

attrib() {
	echo "commit-msg: $1 in the message."
	echo
	printf '%s\n' "$whole" | grep -nE "$2" | head -3 | sed 's/^/  /'
	echo
	echo "  $3"
	echo
	echo "  A commit message records what changed and why, not what wrote it."
	exit 1
}

printf '%s\n' "$whole" | grep -Eiq '^[[:space:]]*Claude-Session:' &&
	attrib "a session trailer" '^[[:space:]]*Claude-Session:' \
		"Remove the line. Set attribution.sessionUrl to false in Claude Code settings so it stops being added."
printf '%s\n' "$whole" | grep -Eiq 'claude\.ai/code/session' &&
	attrib "a session URL" 'claude\.ai/code/session' \
		"Remove it. A session link is private, expires, and means nothing to a reader of git log."
printf '%s\n' "$whole" | grep -Eiq '^[[:space:]]*Co-Authored-By:[[:space:]]*Claude' &&
	attrib "a tool co-author trailer" '^[[:space:]]*Co-Authored-By:[[:space:]]*Claude' \
		"Remove the line. Set includeCoAuthoredBy to false in Claude Code settings."
printf '%s\n' "$whole" | grep -Eiq 'Generated with \[?Claude Code' &&
	attrib "a generator credit" 'Generated with \[?Claude Code' \
		"Remove the line."

exit 0
