#!/bin/sh
# Pre-commit gate. Install with: make hooks
#
# Never bypass this with --no-verify. If a check is wrong, fix the check.
set -e

# The refusals first, because they are instant and each one saves the three
# minutes the rest of this costs: a commit on main, and an em dash added to
# prose. scripts/guard says why each exists.
echo "pre-commit: guards"
scripts/guard branch
scripts/guard prose --staged

echo "pre-commit: gofumpt"
unformatted=$(gofumpt -l .)
if [ -n "$unformatted" ]; then
	echo "not formatted:"
	echo "$unformatted"
	echo "run: make fmt"
	exit 1
fi

echo "pre-commit: golangci-lint"
golangci-lint run

echo "pre-commit: go test"
go test ./...

echo "pre-commit: ok"
