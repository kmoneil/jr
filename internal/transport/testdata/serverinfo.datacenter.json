        "path": "/rest/api/2/serverInfo"
      },
      "response": {
        "status": 200,
        "header": {
          "Content-Type": [
            "application/json;charset=UTF-8"
          ]
        },
        "body": "{\"baseUrl\":\"https://jira.acme.internal\",\"version\":\"9.12.7\",\"versionNumbers\":[9,12,7],\"deploymentType\":\"Server\",\"buildNumber\":912007,\"serverTitle\":\"Jira Data Center\"}"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/rest/api/2/myself"
      },
      "response": {
        "status": 200,
        "header": {
          "Content-Type": [
            "application/json;charset=UTF-8"
          ]
        },
        "body": "{\"key\":\"ada\",\"name\":\"ada\",\"displayName\":\"Ada Lovelace\",\"active\":true}"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/rest/api/2/issue/ENG-9999",
