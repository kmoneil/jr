# Copy to .env and edit. Every value has a default in docker-compose.yml; this
# file is only where you deviate from one. `.env` is gitignored.

# The line to record against.
#
# 10.4 is the default because it is the version this rig was first proven
# against end to end, and because it is post-9.0: `/rest/api/2/issue/createmeta`
# was removed there, so recording here proves the replacement endpoint rather
# than the assumption.
#
# The other two worth a pass, and what each one answers:
#
#   9.12  the last line before the createmeta removal, and the last with H2.
#         Records the *old* shape, which is what a customer on 9.x LTS still
#         serves.
#   11.3  the current line. Refuses HTTP Basic entirely — a personal access
#         token is the only way in — and adds `maxResultWindow` to search
#         responses. Recording here is how the next removal gets caught.
JIRA_VERSION=10.4.0
POSTGRES_VERSION=16

# Host side only; the container is always 8080 internally. 8080 on the host is
# crowded enough that a collision is the likely first failure.
JIRA_PORT=9493

# Empty serves Jira at the root, which is what every *.datacenter.json in this
# tree looks like today: the recorder stores req.URL.Path verbatim, so a context
# path lands inside the fixture and no existing cassette carries one. Record the
# nine outstanding groups at the root. `/jira` is a separate deliberate run —
# see the README.
CONTEXT_PATH=

# Jira is unhappy under about 2g. Raise both if the first page load crawls.
JVM_MINIMUM_MEMORY=1024m
JVM_MAXIMUM_MEMORY=2048m

# Local throwaway database. Not exposed outside the compose network.
DB_NAME=jira
DB_USER=jira
DB_PASSWORD=jira

# The administrator this rig creates. The name lands in every fixture as the
# reporter, so it is fictional and stays fictional — see the README on why
# nothing here is scrubbed.
ADMIN_USER=ada
ADMIN_PASSWORD=fixtures-only
ADMIN_FULLNAME="Ada Lovelace"
ADMIN_EMAIL=ada@recorded.invalid
