#!/usr/bin/env bash
# land — take one green pull request to main, the way this repo merges.
#
#   scripts/land <pr-number>
#
# Steps, refusing loudly at each: a clean tree; the PR's branch checked
# out, holding nothing origin does not; a rebase onto the base when the
# ruleset would refuse the merge as behind, with the generated files
# re-verified afterwards, because a textually clean rebase can still
# disagree with its generators when the other side moved a kind, a command,
# or a doc; a green ci-wait on the commit this checkout holds; a squash
# merge of exactly that commit, which deletes the branch; the base pulled,
# when this checkout can switch to it.
#
# It never resolves a conflict and never force-pushes anything but the
# PR's own head branch. A stopped rebase is left in place for a human.
set -euo pipefail

pr=${1:?usage: scripts/land <pr-number>}
here=$(cd "$(dirname "$0")" && pwd)

if [ -n "$(git status --porcelain)" ]; then
	git status --short
	echo "land: the tree is not clean" >&2
	exit 1
fi

state=$(gh pr view "$pr" --json state --jq .state)
if [ "$state" != OPEN ]; then
	echo "land: PR $pr is $state" >&2
	exit 1
fi
branch=$(gh pr view "$pr" --json headRefName --jq .headRefName)
base=$(gh pr view "$pr" --json baseRefName --jq .baseRefName)

git fetch origin -q
git switch -q "$branch" 2>/dev/null ||
	git switch -q -c "$branch" --track "origin/$branch"
git pull -q --ff-only origin "$branch"

# What land waits on and merges is this checkout's head, so it has to be
# the one GitHub has. A local commit nobody pushed has no checks that will
# ever run, and merging the pushed head instead would leave it behind.
if [ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$branch")" ]; then
	echo "land: $branch has commits that are not on origin; push them," \
		"or drop them, before landing" >&2
	exit 1
fi

if ! git merge-base --is-ancestor "origin/$base" HEAD; then
	echo "land: $branch is behind origin/$base; rebasing"
	if ! git rebase "origin/$base"; then
		echo "land: the rebase stopped; resolve it, run" \
			"'git rebase --continue', then re-run land" >&2
		exit 1
	fi
	make docs >/dev/null
	make skill >/dev/null
	make golden >/dev/null
	if [ -n "$(git status --porcelain)" ]; then
		git status --short
		echo "land: the rebased tree disagrees with its generators;" \
			"review and commit the regeneration before landing" >&2
		exit 1
	fi
	git push -q --force-with-lease
fi

# The commit to wait on is the one this checkout holds, which after a
# rebase is the one just pushed. Asking GitHub for the PR's head raced the
# push: it answered with the head the push replaced, ci-wait found that
# green, and the merge was handed a head whose checks had not started (PRs
# 197 and 228; the ruleset refused both). ci-wait waits on a commit with no
# checks yet rather than reading it as green, and --match-head-commit has
# the server refuse to merge anything else.
head=$(git rev-parse HEAD)
"$here/ci-wait" "$head"

gh pr merge "$pr" --squash --delete-branch --match-head-commit "$head"

# The base can be checked out in another worktree, and git will not switch
# to it here then. The pull used to run anyway, into the branch this
# checkout was still on (PR 230), so say where the base is instead.
if git switch -q "$base" 2>/dev/null; then
	git pull -q --ff-only origin "$base"
else
	where=$(git worktree list --porcelain | awk -v ref="branch refs/heads/$base" '
		/^worktree / { tree = substr($0, 10) }
		$0 == ref { print tree }')
	echo "land: $base is checked out in ${where:-another worktree}," \
		"so it was not pulled here; pull it there" >&2
fi
echo "landed: PR $pr onto $base"
